# ==============================================================================
# PSC Frontend - Production Dockerfile
# ==============================================================================
# Multi-stage build: Node.js builds Angular, nginx serves static files
# Results in ~25MB image vs ~1GB+ for dev server
# ==============================================================================

# Stage 1: Build the Angular application
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files first for better layer caching
COPY package*.json ./

# Install dependencies (using npm install to handle lock file version differences)
RUN npm install

# Copy source code
COPY . .

# Build for production (uses production configuration from angular.json)
RUN npm run build -- --configuration=production

# Stage 2: Serve with nginx (tiny footprint)
FROM nginx:alpine

# Copy custom nginx config for SPA routing
COPY nginx.conf /etc/nginx/nginx.conf

# Copy built assets from builder stage
# Angular 17+ outputs to dist/<project>/browser
COPY --from=builder /app/dist/political-scorecard-frontend/browser /usr/share/nginx/html

# Expose port 4200 to match existing proxy config
EXPOSE 4200

# Run nginx in foreground
CMD ["nginx", "-g", "daemon off;"]
